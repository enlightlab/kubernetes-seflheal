# Copy to .env and fill in after OKE + OCIR setup
DEPLOY_TARGET=oci
IN_CLUSTER=true
USE_PORT_FORWARD=false

# Oracle OKE — leave KUBE_CONTEXT empty when running inside the cluster
# KUBE_CONTEXT=
# KUBECONFIG=

NAMESPACE=enlight-staging
ARGOCD_NAMESPACE=argocd
ARGOCD_APP=fastapi-staging
DEPLOYMENT_NAME=fastapi
CONTAINER_NAME=api

# OCIR example: iad.ocir.io/tenancy-namespace/enlight/enlight-fastapi:demo-pass
BAD_IMAGE=enlight-fastapi:DOES-NOT-EXIST
GOOD_IMAGE=enlight-fastapi:demo-pass

# In-cluster checks (inside OKE pod)
APP_HEALTH_CHECK_URL=http://fastapi.enlight-staging.svc.cluster.local/health
APP_DASHBOARD_CHECK_URL=http://fastapi.enlight-staging.svc.cluster.local
ARGOCD_CHECK_URL=http://argocd-server.argocd.svc.cluster.local

# Public URLs for browser links (OCI ingress / load balancer)
PUBLIC_APP_HEALTH_URL=https://selfheal.enlightlab.com/staging/health
PUBLIC_APP_DASHBOARD_URL=https://selfheal.enlightlab.com/staging/
PUBLIC_ARGOCD_URL=https://argocd.enlightlab.com
PUBLIC_ARGOCD_APP_URL=https://argocd.enlightlab.com/applications/argocd/fastapi-staging

HEAL_OVERLAY_PATH=/app/deploy/k8s/staging-heal

# HolmesGPT — prefer Robusta (no LLM API key in selfheal-ui):
#   bash deploy/oci/setup-robusta-holmes.sh
# Or direct LLM keys:
# GEMINI_API_KEY=AIza...
